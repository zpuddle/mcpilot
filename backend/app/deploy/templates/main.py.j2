"""
Auto-generated MCP Service: {{ service_name }}
Slug: {{ service_slug }}
Transport: {{ transport }}
"""
import inspect
from typing import Any
from fastmcp import FastMCP

# Import user handlers
from handlers import *  # noqa: F401, F403
import handlers

mcp = FastMCP("{{ service_name }}")


async def _invoke_handler(handler_name, **kwargs):
    handler = getattr(handlers, handler_name)
    result = handler(**kwargs)
    if inspect.isawaitable(result):
        result = await result
    return result


# ─── Register Tools ──────────────────────────────────────────────────────────
{% for tool in tools %}
{% if tool.is_enabled %}

@mcp.tool(name="{{ tool.name }}", description="{{ tool.description }}")
async def _tool_{{ tool.handler_name }}({{ tool.signature }}):
    return await _invoke_handler("{{ tool.handler_name }}"{% if tool.call_kwargs %}, {{ tool.call_kwargs }}{% endif %})
{% endif %}
{% endfor %}

# ─── Register Resources ──────────────────────────────────────────────────────
{% for resource in resources %}
{% if resource.is_enabled %}

@mcp.resource("{{ resource.uri_template }}", name="{{ resource.name }}", description="{{ resource.description }}", mime_type="{{ resource.mime_type }}")
async def _resource_{{ resource.handler_name }}({{ resource.signature }}):
    return await _invoke_handler("{{ resource.handler_name }}"{% if resource.call_kwargs %}, {{ resource.call_kwargs }}{% endif %})
{% endif %}
{% endfor %}

# ─── Health Check Endpoint ───────────────────────────────────────────────────

from starlette.routing import Route
from starlette.responses import JSONResponse


async def health_check(request):
    return JSONResponse({"status": "healthy", "service": "{{ service_slug }}"})


# Add health route to the underlying ASGI app if possible
try:
    app = mcp.get_app()
    if hasattr(app, 'routes'):
        app.routes.append(Route("/health", health_check, methods=["GET"]))
except Exception:
    pass

if __name__ == "__main__":
    mcp.run(transport="{{ transport }}", host="0.0.0.0", port={{ port }})
