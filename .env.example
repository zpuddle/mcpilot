# === 必需配置（无默认值，启动时必须设置）===
SECRET_KEY=your-secret-key-here-change-in-production
ADMIN_PASSWORD=your-admin-password

# === 可选配置 ===
ADMIN_USERNAME=admin
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DATABASE_URL=postgresql+asyncpg://mcpadmin:mcpadmin123@localhost:5432/mcpilot

# Server
HOST=0.0.0.0
PORT=8020
LOG_LEVEL=INFO

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Docker
# DOCKER_HOST 留空即可，docker.from_env() 会自动检测平台:
#   Linux/macOS: unix:///var/run/docker.sock
#   Windows: npipe:////./pipe/docker_engine
# 仅在特殊情况下（如远程 Docker）才需要手动设置
DOCKER_HOST=
MCP_SERVICE_PORT_RANGE_START=9001
MCP_SERVICE_PORT_RANGE_END=9999
MCP_SERVICE_NETWORK=mcp-services-net
MCP_SERVICE_MEMORY_LIMIT=512m
MCP_SERVICE_CPU_LIMIT=1.0

# Admin
ADMIN_EMAIL=admin@example.com
